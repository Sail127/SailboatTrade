# Pooled (pgBouncer) — used by your Next.js app
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Direct (non-pooled) — used by Prisma migrate/introspect
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Cloudflare R2
R2_ACCOUNT_ID="your_r2_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="sailboattrade-media"
R2_ENDPOINT="https://your_r2_account_id.r2.cloudflarestorage.com"

# Resend
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM="SailboatTrade <notifications@notify.sailboattrade.com>"
RESEND_REPLY_TO="support@sailboattrade.com"

# PayPal Expanded Checkout
PAYPAL_ENVIRONMENT="sandbox"
PAYPAL_CLIENT_ID="your_paypal_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret"
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your_paypal_client_id"
PAYPAL_BRAND_NAME="SailboatTrade"
# Optional card verification mode: SCA_WHEN_REQUIRED or SCA_ALWAYS
PAYPAL_CARD_3DS_METHOD="SCA_WHEN_REQUIRED"

# Listing pricing (USD cents per month)
PHOTO_PLUS_25_PRICE_USD_CENTS=500
FEATURED_HOME_PRICE_USD_CENTS=700

# App URLs
APP_URL="https://sailboattrade.com"
NEXT_PUBLIC_SITE_URL="https://www.sailboattrade.com"
CANONICAL_HOST="www.sailboattrade.com"
FORCE_HTTPS="true"

# Auth / tokens
AUTH_SECRET="generate_a_long_random_secret"
RESET_TOKEN_SECRET="generate_a_long_random_secret"
EMAIL_TEST_TOKEN="generate_a_long_random_token"
ADMIN_REVIEW_EMAIL="support@sailboattrade.com"
SUPPORT_EMAIL="support@sailboattrade.com"

# Optional: Resend webhook signing
RESEND_WEBHOOK_SIGNING_SECRET="your_resend_signing_secret"
