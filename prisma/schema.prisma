generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum ListingStatus {
  DRAFT
  READY_FOR_CHECKOUT
  PENDING_REVIEW
  REJECTED
  PUBLISHED
  ARCHIVED
  REMOVED
}

enum ListingPlan {
  STANDARD
  FEATURED_HOME
}

enum PaymentStatus {
  NONE
  PENDING
  PAID
  FAILED
}

enum ContentReviewStatus {
  NONE
  PENDING
  REJECTED
}

enum HullType {
  MONOHULL
  CATAMARAN
  TRIMARAN
}

enum SellerRole {
  OWNER
  BROKER
}

enum BoatCondition {
  NEW
  USED
}

enum FuelType {
  DIESEL
  GAS
}

enum VolumeUnit {
  gal
  L
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?

  firstName    String?
  lastName     String?
  businessName String?

  passwordHash String

  // ✅ Email verification (Phase 1)
  emailVerifiedAt          DateTime?
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?
  emailVerificationSentAt  DateTime?

  role       UserRole @default(USER)
  isDisabled Boolean  @default(false)
  disabledAt DateTime?
  deletedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings                 Listing[]
  favorites                Favorite[]
  reviewedListings         Listing[] @relation("ListingReviewedBy")
  removedListings          Listing[] @relation("ListingRemovedBy")
  contentReviewedListings  Listing[] @relation("ListingContentReviewedBy")
  auditLogs                AdminAuditLog[]
}



model Listing {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  title       String?
  description String?

  locationCountry  String?
  locationCity     String?
  locationState    String?
  locationUsRegion String?

  price    Int?
  currency String?

  year          Int?
  builder       String?
  model         String?
  boatCondition BoatCondition?

  cabins Int?
  heads  Int?

  type HullType?

  loa          Float?
  loaUnit      String?
  draft        Float?
  draftUnit    String?
  airDraft     Float?
  airDraftUnit String?

  engineFuel       FuelType?
  engineMake       String?
  engineModel      String?
  propeller        String?
  engineHorsepower Int?

  engineHours      Int?
  leftEngineHours  Int?
  rightEngineHours Int?

  hasGenerator   Boolean @default(false)
  generatorFuel  FuelType?
  generatorMake  String?
  generatorKw    Float?
  generatorHours Int?

  tankUnit    VolumeUnit?
  tankFuel    Float?
  tankWater   Float?
  tankHolding Float?

  hasDinghy        Boolean @default(false)
  dinghyModel      String?
  dinghyLength     Float?
  dinghyLengthUnit String?
  dinghyMotor      Boolean?

  equipment    String[] @default([])
  heroImageUrl String?
  imageUrls    String[] @default([])

  // -------- Staged (pending) content changes for PUBLISHED listings --------
  pendingTitle        String?
  pendingDescription  String?
  pendingHeroImageUrl String?
  pendingImageUrls    String[] @default([])

  contentReviewStatus    ContentReviewStatus @default(NONE)
  contentSubmittedAt     DateTime?
  contentReviewedAt      DateTime?
  contentReviewedById    String?
  contentReviewedBy      User? @relation("ListingContentReviewedBy", fields: [contentReviewedById], references: [id])
  contentRejectionReason String?

  sellerRole         SellerRole?
  listingContactName String?
  contactEmail       String?
  contactPhone       String?

  brokerageName    String?
  brokerageAddress String?
  brokerLogoUrl    String?

  previewToken String @unique @default(cuid())

  status ListingStatus @default(DRAFT)
  plan   ListingPlan   @default(STANDARD)

  paymentStatus        PaymentStatus @default(NONE)
  paymentProvider      String?
  paymentSessionId     String?
  paidAt               DateTime?
  submittedForReviewAt DateTime?
  publishedAt          DateTime?

  // -------- Moderation (new listing approval / takedown) --------
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User? @relation("ListingReviewedBy", fields: [reviewedById], references: [id])
  rejectionReason String?

  removedAt     DateTime?
  removedById   String?
  removedBy     User? @relation("ListingRemovedBy", fields: [removedById], references: [id])
  removedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  favorites Favorite[]
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id])

  @@unique([userId, listingId])
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  actorId String
  actor   User @relation(fields: [actorId], references: [id])

  action     String
  entityType String
  entityId   String

  reason String?
  meta   Json?
}
