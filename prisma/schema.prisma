// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  REJECTED
  PUBLISHED
  SOLD
  ARCHIVED
  REMOVED
}

enum ContentReviewStatus {
  NONE
  PENDING
  REJECTED
}

enum HullType {
  MONOHULL
  CATAMARAN
  TRIMARAN
}

enum SellerRole {
  OWNER
  BROKER
}

enum BoatCondition {
  NEW
  USED
}

enum FuelType {
  DIESEL
  GAS
}

enum VolumeUnit {
  gal
  L
}

enum WeightUnit {
  lb
  kg
}

/**
 * ✅ Photo entitlement (drives server enforcement)
 * FREE_3 => free listing, max 3 photos
 * PHOTO_PLUS_25 => paid subscription upgrade, max 25 photos
 */
enum PhotoPlan {
  FREE_3
  PHOTO_PLUS_25
}

/**
 * ✅ Billing state for paid listing upgrades
 * FREE => no subscription
 * ACTIVE => subscription active
 * PAST_DUE => billing problem
 * CANCELED => billing canceled/closed
 */
enum BillingStatus {
  FREE
  ACTIVE
  PAST_DUE
  CANCELED
}

model User {
  id    String  @id @default(cuid())
  email String  @unique
  name  String?

  firstName String?
  lastName  String?

  businessName String?

  // ✅ Listing Contact auto-fill
  sellerRole SellerRole?
  phoneE164  String?

  // ✅ Brokerage (account profile)
  brokerageName    String?
  brokerageStreet  String?
  brokerageCity    String?
  brokerageState   String?
  brokerageCountry String? // ✅ allow ISO2 or typed "Other" safely

  // ✅ Broker hero/logo image (3:2 logo style)
  brokerHeroImageUrl String?

  // ✅ Homeport (future)
  homeportCountry String?
  homeportRegion  String?
  homeportState   String?
  homeportAdmin1  String?
  homeportCity    String?

  passwordHash String

  // ✅ Email verification
  emailVerifiedAt          DateTime?
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?
  emailVerificationSentAt  DateTime?

  role       UserRole  @default(USER)
  isDisabled Boolean   @default(false)
  disabledAt DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  listings                Listing[]
  favorites               Favorite[]
  savedSearches           SavedSearch[]
  saleReports             ListingSaleReport[]
  reviewedListings        Listing[]       @relation("ListingReviewedBy")
  removedListings         Listing[]       @relation("ListingRemovedBy")
  contentReviewedListings Listing[]       @relation("ListingContentReviewedBy")
  auditLogs               AdminAuditLog[]
  draftUploads            DraftUpload[]
}

model EmailDeliveryEvent {
  id String @id @default(cuid())

  provider          String
  providerEventId   String? @unique
  providerMessageId String?
  eventType         String

  sender    String?
  recipient String?
  subject   String?

  occurredAt DateTime?
  payload    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider, createdAt])
  @@index([providerMessageId])
  @@index([recipient, createdAt])
  @@index([eventType, createdAt])
}

model Listing {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  title       String?
  description String?

  // ✅ Form truth: ISO2 or typed "Other"
  locationCountry  String?
  locationCity     String?
  locationState    String?
  locationUsRegion String?

  price    Int?
  currency String?

  year          Int?
  builder       String?
  model         String?
  boatCondition BoatCondition?

  cabins Int?
  heads  Int?

  type HullType?

  loa          Float?
  loaUnit      String?
  draft        Float?
  draftUnit    String?
  airDraft     Float?
  airDraftUnit String?

  displacement     Float?
  displacementUnit WeightUnit?

  engineFuel       FuelType?
  engineMake       String?
  propeller        String?
  engineHorsepower Int?

  engineHours      Int?
  leftEngineHours  Int?
  rightEngineHours Int?

  hasGenerator   Boolean   @default(false)
  generatorFuel  FuelType?
  generatorMake  String?
  generatorKw    Float?
  generatorHours Int?

  tankUnit  VolumeUnit?
  tankFuel  Float?
  tankWater Float?

  // ✅ Form truth: yes/no + free text "dinghy details"
  hasDinghy     Boolean @default(false)
  dinghyDetails String?

  equipment    String[] @default([])
  heroImageUrl String?
  imageUrls    String[] @default([])
  heroImageFrame Json?

  riggingRemarks String?
  additionalInfo String?

  // ============================
  // ✅ FREE + PAID LISTING PLAN
  // ============================
  photoPlan PhotoPlan @default(FREE_3)

  // ✅ Upgrade: featured on home page
  featuredHome Boolean @default(false)

  // ✅ Subscription billing state (for upgrades)
  billingStatus BillingStatus @default(FREE)

  // provider details
  billingProvider String? // "PAYPAL"
  billingAddons           String[] @default([]) // e.g. ["PHOTO_PLUS_25","FEATURED_HOME"]

  billingCurrency     String @default("USD")
  billingMonthlyCents Int? // total subscription cents for current config

  billingCurrentPeriodStart DateTime?
  billingCurrentPeriodEnd   DateTime?
  cancelAtPeriodEnd         Boolean   @default(false)
  canceledAt                DateTime?
  lastPaidAt                DateTime?
  billingTermMonths         Int?
  billingAutoRenew          Boolean   @default(false)
  billingSubscriptionId     String?   @unique
  billingPlanId             String?

  // ============================
  // ✅ REVIEW / MODERATION FLOW
  // ============================
  contentReviewStatus    ContentReviewStatus @default(NONE)
  contentSubmittedAt     DateTime?
  contentReviewedAt      DateTime?
  contentReviewedById    String?
  contentReviewedBy      User?               @relation("ListingContentReviewedBy", fields: [contentReviewedById], references: [id])
  contentRejectionReason String?

  sellerRole         SellerRole?
  listingContactName String?
  contactEmail       String?
  contactPhone       String?

  brokerageName      String?
  brokerageAddress   String?
  brokerHeroImageUrl String?

  previewToken String @unique @default(cuid())

  status ListingStatus @default(DRAFT)

  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?     @relation("ListingReviewedBy", fields: [reviewedById], references: [id])
  rejectionReason String?

  removedAt     DateTime?
  removedById   String?
  removedBy     User?     @relation("ListingRemovedBy", fields: [removedById], references: [id])
  removedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
    // ✅ Listing expiration
  expiresAt DateTime?
  renewalReminderLastSentAt DateTime?
  expiredEmailSentAt        DateTime?
  archivedAt DateTime?
  archivedImagesPrunedAt DateTime?

  favorites Favorite[]
  saleReport ListingSaleReport?
  draftUploads DraftUpload[]
}

model DraftUpload {
  id String @id @default(cuid())
  key String @unique

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  claimedListingId String?
  claimedListing Listing? @relation(fields: [claimedListingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  lastTouchedAt DateTime @default(now())
  claimedAt DateTime?

  @@index([userId, lastTouchedAt])
  @@index([claimedListingId])
  @@index([claimedAt, lastTouchedAt])
}

model ListingSaleReport {
  id        String   @id @default(cuid())
  listingId String   @unique
  ownerId   String

  soldOnSailboatTrade Boolean
  feedback            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([soldOnSailboatTrade, createdAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id])

  @@unique([userId, listingId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  path      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  action     String
  entityType String
  entityId   String

  reason String?
  meta   Json?
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}
