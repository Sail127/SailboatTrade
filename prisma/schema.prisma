generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ListingStatus {
  DRAFT
  READY_FOR_CHECKOUT
  PUBLISHED
  ARCHIVED
}

enum ListingPlan {
  STANDARD
  FEATURED_HOME
}

enum PaymentStatus {
  NONE
  PENDING
  PAID
  FAILED
}

enum HullType {
  MONOHULL
  CATAMARAN
  TRIMARAN
}

enum SellerRole {
  OWNER
  BROKER
}

enum BoatCondition {
  NEW
  USED
}

enum FuelType {
  DIESEL
  GAS
}

enum VolumeUnit {
  gal
  L
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())

  listings  Listing[]
  favorites Favorite[]
}

model Listing {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  // From form payload
  title       String?
  description String?

  // Location
  locationCountry  String?
  locationCity     String?
  locationState    String?
  locationUsRegion String?

  // Price
  price    Int?    // whole dollars from parseWholeDollars
  currency String?

  // Boat basics
  year          Int?
  builder       String?
  model         String?
  boatCondition BoatCondition?

  cabins Int?
  heads  Int?

  type HullType?

  // Dimensions
  loa         Float?
  loaUnit     String?
  draft       Float?
  draftUnit   String?
  airDraft    Float?
  airDraftUnit String?

  // Engines
  engineFuel       FuelType?
  engineMake       String?
  engineModel      String?
  propeller        String?
  engineHorsepower Int?

  engineHours      Int?
  leftEngineHours  Int?
  rightEngineHours Int?

  // Generator
  hasGenerator   Boolean @default(false)
  generatorFuel  FuelType?
  generatorMake  String?
  generatorKw    Float?
  generatorHours Int?

  // Tanks
  tankUnit    VolumeUnit?
  tankFuel    Float?
  tankWater   Float?
  tankHolding Float?

  // Dinghy
  hasDinghy        Boolean @default(false)
  dinghyModel      String?
  dinghyLength     Float?
  dinghyLengthUnit String?
  dinghyMotor      Boolean?

  // Equipment + Media
  equipment   String[] @default([])
  heroImageUrl String?
  imageUrls    String[] @default([])

  // Contact / seller
  sellerRole         SellerRole?
  listingContactName String?
  contactEmail       String?
  contactPhone       String?

  brokerageName    String?
  brokerageAddress String?
  brokerLogoUrl    String?

  // Draft preview + payments (you already use these)
  previewToken String @unique @default(cuid())

  status ListingStatus @default(DRAFT)
  plan   ListingPlan   @default(STANDARD)

  paymentStatus    PaymentStatus @default(NONE)
  paymentProvider  String?
  paymentSessionId String?
  paidAt           DateTime?
  publishedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  favorites Favorite[]
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id])

  @@unique([userId, listingId])
}
